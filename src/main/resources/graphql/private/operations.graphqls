query GetAllUsers {
  getAllUsers {
    id
    firstName
    lastName
    email
    phoneNumber
    role
    status
    createdAt
  }
}

query GetCurrentUser {
  getCurrentUser {
    id
    firstName
    lastName
    email
    phoneNumber
    role
    status
    createdAt
    eventCategoryPreferences
    biography
    language
    notificationsEnabled
    twoFactorEnabled
  }
}

mutation UpdateUser($input: UpdateUserInput!) {
  updateUser(input: $input) {
    id
    firstName
    lastName
    phoneNumber
    biography
  }
}

mutation UpdateUserPreferences($input: UpdateUserPreferencesInput!) {
  updateUserPreferences(input: $input) {
    id
    eventCategoryPreferences
    language
    notificationsEnabled
    twoFactorEnabled
  }
}

mutation InitiateTwoFactor {
  initiateTwoFactor
}

mutation ConfirmTwoFactor($otp: String!) {
  confirmTwoFactor(otp: $otp)
}

mutation SuspendUser($id: String!, $suspendedUntil: String!) {
  suspendUser(id: $id, suspendedUntil: $suspendedUntil) {
    id
    status
    suspendedUntil
  }
}

mutation DeleteUser($id: String!) {
  deleteUser(id: $id)
}

mutation CreateEvent($input: CreateEventInput!) {
  createEvent(input: $input) {
    id
    details {
      title
      description
      startTime
      endTime
      location
      nrVolunteers
      contactPhone
      contactEmail
      dressCode
    }
    category
    storageFolderId
    status
    createdAt
    createdBy
  }
}

mutation UpdateEvent($id: String!, $input: UpdateEventInput!) {
  updateEvent(id: $id, input: $input) {
    id
    details {
      title
      description
      startTime
      endTime
      location
      nrVolunteers
      contactPhone
      contactEmail
      dressCode
    }
    category
    status
  }
}

mutation ApproveEvent($eventId: String!) {
  approveEvent(eventId: $eventId) {
    id
    status
  }
}

mutation RejectEvent($eventId: String!) {
  rejectEvent(eventId: $eventId) {
    id
    status
  }
}

mutation Enroll($input: CreateEnrollmentInput!) {
  enroll(input: $input) {
    id
    eventId
    userId
    status
  }
}

mutation Unenroll($input: UnenrollInput!) {
  unenroll(input: $input) {
    status
  }
}

mutation ConfirmEnrollment($input: ConfirmEnrollmentInput!) {
  confirmEnrollment(input: $input) {
    status
  }
}

query GetAllEvents {
  getAllEvents {
    id
    details {
      title
      description
      startTime
      endTime
      location
      nrVolunteers
      contactPhone
      contactEmail
      dressCode
    }
    files {
      id
      type
    }
    category
    status
    createdAt
    createdBy
  }
}

query GetEventById($id: String!) {
  getEventById(id: $id) {
    id
    details {
      title
      description
      startTime
      endTime
      location
      nrVolunteers
      contactPhone
      contactEmail
      dressCode
    }
    files {
      id
      type
    }
    category
    status
    createdAt
    createdBy
  }
}

query GetCurrentUserEnrollments {
  getCurrentUserEnrollments {
    id
    eventId
    userId
    status
  }
}

query GetEventEnrollmentById($id: String!) {
  getEventEnrollmentById(id: $id) {
    id
    eventId
    userId
    status
  }
}

query GetCurrentUserEvents {
  getCurrentUserEvents {
    id
    details {
      title
      description
      startTime
      endTime
      location
      nrVolunteers
      contactPhone
      contactEmail
      dressCode
    }
    category
    status
    createdAt
    createdBy
    files {
            id
            eventId
            type
            originalName
            contentType
            size
        }
  }
}

query GetEventsCreatedByCurrentUser {
  getEventsCreatedByCurrentUser {
    id
    details {
      title
      description
      startTime
      endTime
      location
      nrVolunteers
      contactPhone
      contactEmail
      dressCode
    }
    files {
      id
      type
    }
    category
    status
    createdAt
    createdBy
  }
}

query GetFilteredEvents($input: EventFilterInput) {
  getFilteredEvents(input: $input) {
    page
    size
    total
    events {
      id
      category
      storageFolderId
      status
      createdAt
      createdBy
      lastModifiedAt
      lastModifiedBy
      files {
        id
        type
      }
      details {
        title
        description
        startTime
        endTime
        location
        nrVolunteers
        contactPhone
        contactEmail
        dressCode
      }
    }
  }
}

query GetUserById($id: String!) {
  getUserById(id: $id) {
    id
    firstName
    lastName
    email
    phoneNumber
    role
    status
    createdAt
  }
}



