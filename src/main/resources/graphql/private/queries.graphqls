type Query {
    getCurrentUser: User!
    getAllUsers: [User!]!
    getUserById(id: String!): User!

    getEventById(id: String!): Event!
    getCurrentUserEvents: [Event!]!
    getEventsCreatedByCurrentUser: [Event!]!
    getAllEvents: [Event!]!
    getFilteredEvents(input: EventFilterInput): PagedEventData!

    getCurrentUserEnrollments: [Enrollment!]!
    getEventEnrollmentById(id: String!): Enrollment
}